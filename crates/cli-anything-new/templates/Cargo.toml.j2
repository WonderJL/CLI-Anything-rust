[package]
name = "{{ crate_name }}"
description = "{{ description }}"
version = "0.1.0"
edition = "2021"
rust-version = "1.89"
license = "Apache-2.0"
publish = false

[[bin]]
name = "{{ crate_name }}"
path = "src/main.rs"

[dependencies]
cli-anything-core = { path = "../cli-anything-core" }
anyhow = "1"
clap = { version = "4", features = ["derive"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
